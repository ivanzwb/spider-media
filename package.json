{
  "name": "spider-media",
  "version": "0.2.0",
  "description": "Obsidian plugin that publishes Markdown notes to WeChat Official Account (微信公众号), Toutiao (头条号) and other Chinese self-media platforms with one click. Renders Mermaid to PNG, inlines CSS, and injects content via embedded Electron webview — no external Chrome / puppeteer required.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "lint": "eslint src/",
    "install:vault": "node install.mjs",
    "version": "node version-bump.mjs && git add manifest.json versions.json"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "obsidian-md",
    "wechat",
    "wechat-official-account",
    "weixin",
    "toutiao",
    "self-media",
    "自媒体",
    "微信公众号",
    "头条号",
    "markdown",
    "markdown-to-html",
    "publish",
    "mermaid",
    "juice",
    "electron",
    "webview",
    "prosemirror",
    "chinese"
  ],
  "author": "ivanzwb",
  "license": "MIT",
  "homepage": "https://github.com/ivanzwb/spider-media#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ivanzwb/spider-media.git"
  },
  "bugs": {
    "url": "https://github.com/ivanzwb/spider-media/issues"
  },
  "dependencies": {
    "juice": "^11.0.0",
    "marked": "^18.0.3",
    "marked-highlight": "^2.0.0"
  },
  "devDependencies": {
    "@types/node": "^25.7.0",
    "@typescript-eslint/eslint-plugin": "^8.59.3",
    "@typescript-eslint/parser": "^8.0.0",
    "builtin-modules": "^5.2.0",
    "esbuild": "^0.28.0",
    "eslint": "^10.3.0",
    "obsidian": "latest",
    "typescript": "^6.0.3"
  }
}
